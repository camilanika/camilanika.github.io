# Hostinger (Apache) settings for camilanika.store
Options -Indexes

# Force HTTPS and drop "www."
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Security headers (QA fix OBS-41, OWASP HTTP Headers Cheat Sheet). Setting Content-Security-Policy here replaces
# the "upgrade-insecure-requests" policy Hostinger's CDN used to send, so it is part of ours.
#   HSTS: HTTPS only for a year (no includeSubDomains, so other subdomains aren't affected)
#   frame-ancestors / X-Frame-Options: only this site may frame its pages (clickjacking; the bill prints from a same-origin frame)
#   nosniff: scripts and styles are only used with their real type (so .js is declared as text/javascript below)
AddType text/javascript .js
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Always the latest version: browsers (and Hostinger's CDN) check every page, script, style, image and video
# with the server on each visit. An unchanged file is answered with a short "304 Not Modified" and comes from
# the browser's cache, so this costs almost nothing; a changed file is downloaded at once. No ?v= tag has to be
# changed after a deploy. Font files never change, so they are kept for a year. A tab that stays open is
# covered by js/fresh.js (it reloads, or offers "Muat ulang", when the page or its scripts change).
FileETag MTime Size
<IfModule mod_headers.c>
  <FilesMatch "\.(html?|php|js|mjs|css|json|webmanifest|xml|txt|svg|png|jpe?g|webp|gif|ico|mp4|webm)$">
    Header set Cache-Control "no-cache"
    Header unset Expires
  </FilesMatch>
  <FilesMatch "\.(woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>

# Repo-only files: not part of the public website
RedirectMatch 404 ^/(\.git|supabase|tests|docs)(/|$)
RedirectMatch 404 \.(md|sql|ts)$
RedirectMatch 404 /\.(gitignore|nojekyll)$
# Admin-only API reference: only api/docs.php may read it, after an admin check (QA fix OBS-9)
RedirectMatch 404 ^/api/private(/|$)
